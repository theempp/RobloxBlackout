-- Blasters. Guns with locked v2 art (Config.Guns[i].art; data in GunArt/<id>, generated by assets/guns/gun_v2.py) get:
--   build(gun)            world/display model: primitive LOD (replicates; <= Config.TriBudget.WorldGun, measured)
--   buildFirstPerson(gun) client view model: the beveled meshes, built at runtime from EditableMesh (no upload): one
--                         vertex-coloured mesh per moving group; destroying the model frees them. Falls back to
--                         build(gun) if the device refuses an EditableMesh (memory budget).
-- Guns without art (Scatterpop, Rattler) keep their Config.shape primitives. Matte only (owner: no neon/emissive).
-- Both models: PrimaryPart "Root" at the grip origin with Attachment "Muzzle" (+ art points), parts non-colliding, massless.
local Config = require(script.Parent.Config)
local GunModel = {}
local artCache = {}
GunModel.fpStatus = {} -- gunId -> "mesh" | "fallback: <reason>" (tests, perf overlay)

function GunModel.art(id)
	if artCache[id] == nil then
		local folder = script.Parent:FindFirstChild("GunArt")
		local m = folder and folder:FindFirstChild(id)
		artCache[id] = m and require(m) or false
	end
	return artCache[id] or nil
end

-- Static estimate kept for the legacy primitive guns (the real check is the measured render count in tests).
function GunModel.estimateTris(gun)
	local n = 0
	for _, p in ipairs(gun.shape) do
		n += Config.TriEstimate[p.kind] or 12
	end
	return n
end

-- The engraving layer: one call site, so a rename or final logo is a Config change.
function GunModel.engrave(part, face)
	local b = Config.Branding
	if b.DecalId ~= "" then
		local d = Instance.new("Decal")
		d.Name = "Engraving"
		d.Texture = b.DecalId
		d.Face = face
		d.Transparency = 0.2
		d.Parent = part
		return d
	end
	local g = Instance.new("SurfaceGui")
	g.Name = "Engraving"
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 60
	g.LightInfluence = 1
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Text = b.Name
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = Color3.fromRGB(90, 90, 100)
	t.Parent = g
	g.Parent = part
	return g
end

local function settle(p)
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Massless, p.CastShadow = false, false, false, false, true, false
end

local function newModel(gun, art)
	local model = Instance.new("Model")
	model.Name = gun.id
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	settle(root)
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = gun.muzzle
	muzzle.Parent = root
	for name, pos in pairs(art and art.points or {}) do
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = pos
		a.Parent = root
	end
	root.Parent = model
	model.PrimaryPart = root
	return model, root
end

local function weld(root, p, c0)
	local w = Instance.new("Weld")
	w.Part0, w.Part1, w.C0 = root, p, c0
	w.Parent = p
	return w
end

-- Legacy primitive guns (Config.shape).
local function buildShape(gun)
	local model, root = newModel(gun, nil)
	local engraved = false
	for i, spec in ipairs(gun.shape) do
		local p
		local cf = CFrame.new(spec.pos)
		if spec.kind == "Wedge" then
			p = Instance.new("WedgePart")
			p.Size = spec.size
		else
			p = Instance.new("Part")
			if spec.kind == "Cylinder" then
				p.Shape = Enum.PartType.Cylinder -- Roblox cylinders run along X: turn to lie along Z
				p.Size = Vector3.new(spec.size.Z, spec.size.X, spec.size.Y)
				cf *= CFrame.Angles(0, math.rad(90), 0)
			else
				p.Size = spec.size
			end
		end
		p.Name = spec.color .. i
		p.Material = Enum.Material.SmoothPlastic
		p.Color = spec.color == "Accent" and gun.accent or (Config.Colors[spec.color] or Config.Colors.Body)
		settle(p)
		p.CFrame = cf
		weld(root, p, cf)
		p.Parent = model
		if not engraved and spec.color == "Body" and spec.size.Z >= 1 then
			GunModel.engrave(p, Enum.NormalId.Left)
			engraved = true
		end
	end
	return model
end

-- World LOD from the art's primitive list (one block per major silhouette piece, cylinders for tubes).
local function buildWorld(gun, art)
	local model, root = newModel(gun, art)
	local engraved = false
	for i, w in ipairs(art.world) do
		local p = Instance.new("Part")
		local cf = CFrame.new(w.pos) * CFrame.Angles(w.pitch, 0, 0)
		if w.kind == "Cylinder" then
			p.Shape = Enum.PartType.Cylinder
			p.Size = Vector3.new(w.size.Z, w.size.X, w.size.Y)
			cf *= CFrame.Angles(0, math.rad(90), 0)
		else
			p.Size = w.size
		end
		local z = art.zones[w.zone]
		p.Name = w.group .. "_" .. w.zone .. i
		p.Color, p.Material = z.color, z.material
		settle(p)
		p:SetAttribute("Group", w.group)
		p.CFrame = cf
		weld(root, p, cf)
		p.Parent = model
		if not engraved and w.group ~= "Mag" and w.zone == "Panel" then
			GunModel.engrave(p, Enum.NormalId.Left)
			engraved = true
		end
	end
	return model
end

function GunModel.build(gun)
	local art = gun.art and GunModel.art(gun.id)
	if art then
		return buildWorld(gun, art)
	end
	return buildShape(gun)
end

-- ---------------------------------------------------------------- first-person meshes (client)
local B64 = {}
do
	local a = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for i = 1, 64 do
		B64[string.byte(a, i)] = i - 1
	end
end

function GunModel.decode(s)
	local n = #s
	local pad = string.sub(s, -2) == "==" and 2 or string.sub(s, -1) == "=" and 1 or 0
	local len = n // 4 * 3 - pad
	local out = buffer.create(len)
	local o = 0
	for i = 1, n, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local v = B64[a] * 262144 + B64[b] * 4096 + (B64[c] or 0) * 64 + (B64[d] or 0)
		buffer.writeu8(out, o, v // 65536)
		if o + 1 < len then
			buffer.writeu8(out, o + 1, (v // 256) % 256)
		end
		if o + 2 < len then
			buffer.writeu8(out, o + 2, v % 256)
		end
		o += 3
	end
	return out
end

-- Decoded geometry per gun, grouped for animation (Receiver / Mover / Mag): positions re-centred on the group's
-- bounds, triangles with a zone index. Cached as plain tables; EditableMeshes are NOT cached (device memory budget).
local geomCache = {}
local function geometry(art)
	local g = geomCache[art.id]
	if g then
		return g
	end
	g = {}
	for _, spec in ipairs(art.meshes) do
		local grp = g[spec.group]
		if not grp then
			grp = { pos = {}, tris = {}, zones = {}, lo = Vector3.one * math.huge, hi = -Vector3.one * math.huge }
			g[spec.group] = grp
		end
		local buf = GunModel.decode(spec.data)
		local base = #grp.pos
		local mn, ext = spec.min, spec.ext
		for i = 0, spec.verts - 1 do
			local o = i * 6
			local v = mn + Vector3.new(buffer.readu16(buf, o) / 65535 * ext.X, buffer.readu16(buf, o + 2) / 65535 * ext.Y,
				buffer.readu16(buf, o + 4) / 65535 * ext.Z)
			table.insert(grp.pos, v)
			grp.lo, grp.hi = grp.lo:Min(v), grp.hi:Max(v)
		end
		local t0 = spec.verts * 6
		for t = 0, spec.tris - 1 do
			local o = t0 + t * 6
			table.insert(grp.tris, { base + buffer.readu16(buf, o) + 1, base + buffer.readu16(buf, o + 2) + 1, base + buffer.readu16(buf, o + 4) + 1, spec.zone })
		end
	end
	for _, grp in pairs(g) do
		grp.centre = (grp.lo + grp.hi) / 2
	end
	geomCache[art.id] = g
	return g
end

-- One group -> one EditableMesh -> one MeshPart, zones as face colours (single matte material).
local function meshPart(AssetService, grp, zones)
	local em = AssetService:CreateEditableMesh()
	if not em then
		error("EditableMesh memory budget reached", 0)
	end
	local ids = table.create(#grp.pos)
	for i, v in ipairs(grp.pos) do
		ids[i] = em:AddVertex(v - grp.centre)
	end
	local colors = {}
	for name, z in pairs(zones) do
		colors[name] = em:AddColor(z.color, 1)
	end
	for _, t in ipairs(grp.tris) do
		local f = em:AddTriangle(ids[t[1]], ids[t[2]], ids[t[3]])
		local c = colors[t[4]]
		em:SetFaceColors(f, { c, c, c })
	end
	local ok, mp = pcall(function()
		local fixed = AssetService:CreateEditableMeshAsync(Content.fromObject(em), { FixedSize = true })
		assert(fixed, "fixed gun mesh memory budget")
		em:Destroy()
		em = fixed
		return AssetService:CreateMeshPartAsync(Content.fromObject(em), { CollisionFidelity = Enum.CollisionFidelity.Box, RenderFidelity = Enum.RenderFidelity.Precise })
	end)
	if not ok then
		em:Destroy()
		error(mp, 0)
	end
	return mp, em
end

local GROUPS = { "Receiver", "Mover", "Mag" }
local function buildMeshes(gun, art)
	local AssetService = game:GetService("AssetService")
	local geo = geometry(art)
	local model, root = newModel(gun, art)
	local live = {}
	model.Destroying:Connect(function()
		for _, em in ipairs(live) do
			em:Destroy() -- frees the device's EditableMesh budget for the next gun
		end
		table.clear(live)
	end)
	local ok, err = pcall(function()
		for _, name in ipairs(GROUPS) do
			local grp = geo[name]
			if grp then
				local mp, em = meshPart(AssetService, grp, art.zones)
				table.insert(live, em)
				mp.Name = name
				mp.Color = Color3.new(1, 1, 1) -- face colours carry the zones
				mp.Material = Enum.Material.SmoothPlastic
				settle(mp)
				mp:SetAttribute("Group", name)
				mp:SetAttribute("Tris", #grp.tris)
				mp.CFrame = CFrame.new(grp.centre)
				weld(root, mp, CFrame.new(grp.centre))
				mp.Parent = model
			end
		end
	end)
	if not ok then
		model:Destroy()
		error(err, 0)
	end
	local e = art.engrave
	if e then -- thin carrier on the gun-left plate; welded to the group that owns the plate (Dart-9: the slide)
		local host = model:FindFirstChild(e.group) or root
		local p = Instance.new("Part")
		p.Name = "EngravePlate"
		p.Size = Vector3.new(0.01, e.size.Y, e.size.X)
		p.Transparency = 1
		settle(p)
		local cf = CFrame.new(e.pos)
		p.CFrame = cf
		weld(host, p, host == root and cf or CFrame.new(geo[e.group].centre):Inverse() * cf)
		p.Parent = model
		GunModel.engrave(p, Enum.NormalId.Left)
	end
	model:SetAttribute("Tris", art.tris)
	return model
end

-- Client only. Builds the first-person meshes (yields briefly); destroy the model to release them.
-- Returns model, "mesh" | "fallback" | "primitive". Fallback = the world LOD (device refused an EditableMesh).
function GunModel.buildFirstPerson(gun)
	local art = gun.art and GunModel.art(gun.id)
	if not art then
		return GunModel.build(gun), "primitive"
	end
	local ok, model = pcall(buildMeshes, gun, art)
	GunModel.fpStatus[gun.id] = ok and "mesh" or ("fallback: " .. tostring(model))
	if not ok then
		warn("[GunModel] first-person mesh for", gun.id, "unavailable, using primitives:", model)
		return GunModel.build(gun), "fallback"
	end
	return model, "mesh"
end


return GunModel

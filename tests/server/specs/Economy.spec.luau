local RS=game:GetService('ReplicatedStorage')
local E=require(RS.BlackoutCrew.Economy)
local Rules=require(RS.BlackoutCrew.Rules)
local C=require(RS.BlackoutCrew.Config)
return function(T)
 local d=Rules.defaultProfile()
 T.eq('no counterfeit credit purchase',E.act(d,'buyGun','buzz',0),false)
 d.credits=1000 T.eq('buy owned gun',E.act(d,'buyGun','buzz',0),true)
 T.eq('price debited',d.credits,0) T.eq('owned granted',d.guns.owned.buzz,true)
 T.eq('duplicate refused',E.act(d,'buyGun','buzz',0),false)
 T.eq('unknown rejected',E.act(d,'buyAttachment','fake',0),false)
 T.eq('premium locked',E.act(d,'claimPremium','1',0),false)
 E.runReward(d,true) T.eq('earned tier',E.tier(d),1)
 T.eq('free tier claim',E.act(d,'claimFree','1',0),true)
 T.eq('claim idempotent',E.act(d,'claimFree','1',0),false)
 for i=1,5 do T.eq('free spin '..i,E.act(d,'freeSpin',nil,0),true) end
 T.check('grand prize real entitlements',d.karts.owned.vortex and d.progress.heli)
 T.eq('sixth free rejected',E.act(d,'freeSpin',nil,0),false)
 local sum=0 for _,x in ipairs(E.odds(d)) do sum+=x.odds end T.near('live odds 100',sum,100)
 T.eq('token spin',E.act(d,'tokenSpin',nil,0),true)
 T.eq('token spent',d.progress.tokens,0)
 local odds=E.odds(d) T.eq('no duplicates removed',#odds,11)
 d.wheel.pity=5 for _,x in ipairs(E.odds(d)) do T.check('pity epic or legendary',x.rank>=3) end
 local migrated=Rules.clean(d) T.check('migration preserves economy and gun',migrated.progress.heli and migrated.guns.owned.buzz and migrated.karts.owned.vortex)
 local clean=E.clean({xp=math.huge,tokens=-10,claimed={f999=true},paidOwned={fake=true}})
 T.eq('invalid xp bounded',clean.xp,400000) T.eq('negative tokens bounded',clean.tokens,0)
 T.eq('unknown grants rejected',next(clean.paidOwned),nil)
 T.eq('paid kill switch',C.Economy.PaidRandomEnabled,false)
 T.eq('production pass id absent',C.Economy.PassProduct,0)
end

{
  "name": "BlackoutCrewHeistTest",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "BlackoutCrew": {
        "$path": "src/shared"
      },
      "BCPlace": {
        "$className": "StringValue",
        "$properties": {
          "Value": "heist"
        }
      }
    },
    "ServerScriptService": {
      "BlackoutCrew": {
        "$path": "src/server"
      },
      "BCTests": {
        "$className": "Folder",
        "Runner": {
          "$path": "tests/server/Runner.server.luau"
        },
        "specs": {
          "$path": "tests/heist/specs"
        },
        "multi": {
          "$path": "tests/heist/multi"
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "BlackoutCrew": {
          "$path": "src/client"
        },
        "BCTestProbe": {
          "$path": "tests/heistclient"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    }
  }
}